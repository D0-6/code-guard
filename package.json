    "security",
    "security-audit",
    "code-quality",
    "quality-gate",
    "owasp",
    "owasp-top-10",
    "static-analysis",
    "vulnerability-scanner",
    "team-intelligence",
    "code-guard",
    "npm-package",
    "git-installable"
  ],
  "author": "Code Guard Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/D0-6/code-guard/issues"
  },
  "homepage": "https://github.com/D0-6/code-guard#readme",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "files": [
    "bob-skills/**/*.md",
    ".bob-team/**/*.json",
    "examples/**/*",
    "scripts/**/*.js",
    "bin/**/*.js",
    "README.md",
    "README_GIT.md",
    "AGENTS.md",
    "INSTALL.md",
    "HOW_TO_USE.md",
    "TESTING_GUIDE.md",
    "GIT_INSTALLATION_GUIDE.md",
